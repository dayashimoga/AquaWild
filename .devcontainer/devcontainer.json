{
  "name": "AquaWild (HydroFauna) Dev Container",
  "image": "ghcr.io/cirruslabs/flutter:3.38.4",
  "customizations": {
    "vscode": {
      "extensions": [
        "Dart-Code.dart-code",
        "Dart-Code.flutter"
      ],
      "settings": {
        "dart.flutterSdkPath": "/sdks/flutter",
        "editor.formatOnSave": true
      }
    }
  },
  "forwardPorts": [8080],
  "postCreateCommand": "flutter doctor && flutter pub get",
  "remoteUser": "root"
}
